<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="$(MapleLibRoot)/MapleLib/MapleLib.csproj" />
  </ItemGroup>
  <Target Name="RequirePinnedSource" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(MapleLibRoot)/LICENSE')" Text="Set MapleLibRoot to the separately pinned MapleLib checkout; see README.md." />
  </Target>
</Project>
